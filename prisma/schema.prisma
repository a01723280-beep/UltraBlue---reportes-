// Prisma schema for UltraBlue - Reportes de Planta
//
// Postgres, hosted on Supabase. Both variables are created automatically by
// the Supabase integration in Vercel, so there is nothing to copy by hand:
//
//   POSTGRES_PRISMA_URL       port 6543, the PgBouncer pool. Serverless
//                             functions must go through it or they exhaust
//                             Postgres' connection limit.
//   POSTGRES_URL_NON_POOLING  port 5432, a session connection. Migrations
//                             only run here, because PgBouncer can't handle
//                             them.
//
// See README.md "Desplegar en Vercel".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// A selectable option for a dropdown field, scoped to a plant + a field key
// (e.g. plantId="cdmx", listKey="operadores", label="Jahaziel Escobedo").
// Operators can add new options inline from the form ("agregar otro").
model MasterListItem {
  id        String   @id @default(cuid())
  plantId   String
  listKey   String
  label     String
  createdAt DateTime @default(now())

  @@unique([plantId, listKey, label])
  @@index([plantId, listKey])
}

// One filled-out report. `data` holds the full answer set as JSON, keyed by
// field id, so the same table serves all 11 report types without a schema
// migration every time a question changes.
model ReportSubmission {
  id         String   @id @default(cuid())
  reportType String
  plantId    String
  operator   String?
  data       Json
  createdAt  DateTime @default(now())

  @@index([plantId, reportType, createdAt])
}
